{
    "$schema": "../gen/schemas/mobile-schema.json",
    "identifier": "mobile",
    "description": "Capability for mobile devices",
    "platforms": [
        "android",
        "iOS"
    ],
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "opener:default",
        "deep-link:default",
        "notification:default",
        "store:default",
        {
            "identifier": "http:default",
            "allow": [
                {
                    "url": "https://api.cognitive.microsofttranslator.com/*"
                }
            ],
            "deny": []
        }
    ]
}